@page
@model AutoTallerPro.Frontend.Pages.Vehiculos.CrearModel
@{
    ViewData["Title"] = "Nuevo vehículo";
    ViewData["EsEdicion"] = false;
    ViewData["Opciones"] = Model.Opciones;
}
@section Styles {
    <link rel="stylesheet" href="~/css/vehiculos.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/grupo-uno.css" asp-append-version="true" />
}

<div class="dashboard grupo-uno-page">
    <div class="dashboard-header"><div><h1>@ViewData["Title"]</h1><p>Administra y registra los vehículos del taller.</p></div><a asp-page="./Index" class="services-btn services-btn-secondary">Volver</a></div>
    <partial name="_Formulario" model="Model" />
</div>
@section Scripts { <partial name="_ScriptsGrupoUno" /> }
