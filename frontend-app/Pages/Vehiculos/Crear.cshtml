@page
@model AutoTallerPro.Frontend.Pages.Vehiculos.CrearModel
@{ ViewData["Title"] = "Crear vehículo"; }
@section Styles { <link rel="stylesheet" href="~/css/grupo-uno.css" asp-append-version="true" /> }
<div class="grupo-uno"><nav aria-label="Módulos del taller"><a asp-page="/Clientes/Index">Clientes</a><a asp-page="/Vehiculos/Index">Vehículos</a><a asp-page="/Categorias/Index">Categorías</a><a asp-page="/Servicios/Index">Servicios</a><a asp-page="/Mecanicos/Index">Mecánicos</a></nav><h1>Crear vehículo</h1><p>Los campos con * son obligatorios.</p>
@if (Model.Error is not null) { <div class="alert alert-danger" role="alert">@Model.Error</div> }
<form method="post" class="card"><div asp-validation-summary="All" class="text-danger" role="alert"></div><div class="campos"><div class="campo"><label asp-for="Input.ClienteId">Propietario *</label><select asp-for="Input.ClienteId" class="form-select"><option value="">Seleccione una opción</option>@foreach (var opcion in Model.Opciones.Where(x => x.Activo || x.Id == Model.Input.ClienteId)) { <option value="@opcion.Id">@opcion.Nombre</option> }</select><span asp-validation-for="Input.ClienteId" class="text-danger"></span></div><div class="campo"><label asp-for="Input.Placa">Placa *</label><input asp-for="Input.Placa" type="text" class="form-control" /><span asp-validation-for="Input.Placa" class="text-danger"></span></div><div class="campo"><label asp-for="Input.Marca">Marca *</label><input asp-for="Input.Marca" type="text" class="form-control" /><span asp-validation-for="Input.Marca" class="text-danger"></span></div><div class="campo"><label asp-for="Input.Modelo">Modelo *</label><input asp-for="Input.Modelo" type="text" class="form-control" /><span asp-validation-for="Input.Modelo" class="text-danger"></span></div><div class="campo"><label asp-for="Input.Anio">Año</label><input asp-for="Input.Anio" type="number" class="form-control" /><span asp-validation-for="Input.Anio" class="text-danger"></span></div><div class="campo"><label asp-for="Input.Color">Color</label><input asp-for="Input.Color" type="text" class="form-control" /><span asp-validation-for="Input.Color" class="text-danger"></span></div><div class="campo"><label asp-for="Input.Activo">Activo</label><input asp-for="Input.Activo" type="checkbox" class="form-check-input" /><span asp-validation-for="Input.Activo" class="text-danger"></span></div></div><div class="acciones"><button type="submit" class="btn btn-primary">Guardar</button><a asp-page="./Index" class="btn btn-secondary">Cancelar</a></div></form></div>
@section Scripts {
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
<script>document.querySelectorAll('form[method="post"]').forEach(f => f.addEventListener('submit', () => { if (typeof $ === 'function' && !$(f).valid()) return; const b = f.querySelector('button[type="submit"]'); if(b) { b.disabled = true; b.textContent = 'Guardando…'; } }));</script>
}
