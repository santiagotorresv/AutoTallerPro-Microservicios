@page
@model AutoTallerPro.Frontend.Pages.Administracion.Usuarios.CrearModel

@section Styles {
    <link rel="stylesheet" href="~/css/usuarios-form.css" asp-append-version="true" />
}


@section Scripts {
    <script src="~/js/usuarios.js" asp-append-version="true"></script>
}

@{
    ViewData["Title"] = "Crear usuario";
}

<div class="container py-4 hu3-form">
    <div class="mb-4">
        <h1 class="fw-bold">Crear usuario</h1>
        <p class="text-muted">Registre los datos de la nueva cuenta. El sistema genera el nombre de usuario a partir del correo y evita duplicados.</p>

        <div class="mb-4 p-3 rounded"
             style="background:var(--primary-soft);
                    border:1px solid var(--border-light);">
            <div class="fw-semibold mb-1">
                <i class="bi bi-envelope-check me-2"></i>
                Invitación por correo
            </div>
            <div class="form-text">
                El administrador no define la contraseña. El sistema solicita una invitación al correo indicado. El destinatario
                debe abrir el mensaje, verificar su dirección y elegir su contraseña en Keycloak.
            </div>
        </div>
    </div>

    @if (Model.Error is not null)
    {
        <div class="alert alert-danger" role="alert">
            @Model.Error
            @if (Model.PuedeReintentar)
            {
                <div class="mt-1">Puede reintentar con la clave y los datos originales.</div>
            }
        </div>
    }

    <div class="card">
        <div class="card-body">
            <form method="post" aria-label="Crear usuario" novalidate data-usuarios-escritura>
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <input type="hidden" asp-for="Clave" />
                <input type="hidden" asp-for="Reintento" />
                <fieldset disabled="@Model.PuedeReintentar">

                    <div class="row mb-3">
                        <label asp-for="Input.Nombre" class="col-sm-2 col-form-label"></label>
                        <div class="col-sm-10">
                            <input asp-for="Input.Nombre" class="form-control" autocomplete="given-name" maxlength="100" />
                            <span asp-validation-for="Input.Nombre" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label asp-for="Input.Apellido" class="col-sm-2 col-form-label"></label>
                        <div class="col-sm-10">
                            <input asp-for="Input.Apellido" class="form-control" autocomplete="family-name" maxlength="100" />
                            <span asp-validation-for="Input.Apellido" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label asp-for="Input.Email" class="col-sm-2 col-form-label"></label>
                        <div class="col-sm-10">
                            <input asp-for="Input.Email" class="form-control" autocomplete="email" maxlength="254" />
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label asp-for="Input.Rol" class="col-sm-2 col-form-label"></label>
                        <div class="col-sm-10">
                            <select asp-for="Input.Rol" class="form-select">
                                <option value="">Seleccione un rol</option>
                                <option value="Administrador">Administrador</option>
                                <option value="Recepcionista">Recepcionista</option>
                            </select>
                            <span asp-validation-for="Input.Rol" class="text-danger"></span>
                        </div>
                    </div>
                </fieldset>

                <div class="row mb-3">
                    <div class="col-sm-2"></div>
                    <div class="col-sm-10">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-person-plus"></i> @(Model.PuedeReintentar ? "Reintentar" : "Crear usuario y solicitar invitación")
                        </button>
                        <a asp-page="./Index" class="btn btn-secondary ms-2">Cancelar</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
