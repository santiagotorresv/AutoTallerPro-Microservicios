@page "{id:int}"
@model AutoTallerPro.Frontend.Pages.Administracion.Usuarios.EditarModel

@section Styles {
    <link rel="stylesheet" href="~/css/usuarios-form.css" asp-append-version="true" />
}

@{
    ViewData["Title"] = "Editar Usuario";
}

<div class="container py-4 hu3-form">
    <div class="mb-4">
        <h1 class="fw-bold">Editar Usuario</h1>
        <p class="text-muted">
            No se ha cargado ningún usuario. La edición y el cambio de estado están temporalmente inhabilitados.
        </p>
    </div>

        <div class="card">
            <div class="card-body">
                <div role="form" aria-label="Editar usuario">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                    <div class="row mb-3">
                        <label asp-for="Input.Username" class="col-sm-2 col-form-label"></label>
                        <div class="col-sm-10">
                            <input asp-for="Input.Username" class="form-control" readonly />
                            <div class="form-text">El nombre de usuario no se puede modificar.</div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label asp-for="Input.Email" class="col-sm-2 col-form-label"></label>
                        <div class="col-sm-10">
                            <input asp-for="Input.Email" class="form-control" autocomplete="email" />
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label asp-for="Input.Rol" class="col-sm-2 col-form-label"></label>
                        <div class="col-sm-10">
                            <select asp-for="Input.Rol" class="form-select">
                                <option value="">Sin datos del usuario</option>
                                <option value="Administrador">Administrador</option>
                                <option value="Recepcionista">Recepcionista</option>
                            </select>
                            <span asp-validation-for="Input.Rol" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label asp-for="Input.Activo" class="col-sm-2 col-form-label"></label>
                        <div class="col-sm-10">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="Input_Activo" name="Input.Activo"
                                       disabled data-estado-usuario-pendiente aria-describedby="usuario-estado-pendiente" />
                                <label class="form-check-label" asp-for="Input.Activo">
                                    Usuario activo (puede iniciar sesión)
                                </label>
                            </div>
                            <span id="usuario-estado-pendiente" class="form-text">Estado no disponible.</span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-2"></div>
                        <div class="col-sm-10">
                            <button type="button" disabled title="Operación temporalmente inhabilitada" data-operacion-usuario class="btn btn-primary">
                                <i class="bi bi-save"></i> Guardar Cambios
                            </button>
                            <a asp-page="./Index" class="btn btn-secondary ms-2">Cancelar</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
</div>

@section Scripts {
    <script src="~/js/usuarios.js" asp-append-version="true"></script>
}
