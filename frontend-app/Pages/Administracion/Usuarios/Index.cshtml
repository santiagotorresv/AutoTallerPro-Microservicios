@page
@model AutoTallerPro.Frontend.Pages.Administracion.Usuarios.IndexModel
@{
    ViewData["Title"] = "Gestión de Usuarios";
}

@section Styles {
    <link rel="stylesheet" href="~/css/usuarios.css" asp-append-version="true" />
}

<div class="container py-4 hu3-usuarios">
    <div class="mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h1 class="fw-bold">Gestión de Usuarios</h1>
            <p class="text-muted">Listado de usuarios registrados en el sistema.</p>
        </div>
        <a asp-page="./Crear" class="btn btn-primary">
            <i class="bi bi-person-plus"></i> Crear Usuario
        </a>
    </div>

    @if (TempData["UsuariosMensaje"] is string mensaje)
    {
        <div class="alert alert-success" role="status">@mensaje</div>
    }
    @if (Model.Error is not null)
    {
        <div class="alert alert-danger" role="alert">
            @Model.Error
            @if (Model.Pendiente is { } pendiente)
            {
                <form method="post" asp-page-handler="Accion" class="mt-2"
                      asp-route-Busqueda="@Model.Busqueda" asp-route-RolFiltro="@Model.RolFiltro"
                      asp-route-ActivoFiltro="@Model.ActivoFiltro" asp-route-Pagina="@Model.Pagina">
                    <input type="hidden" name="id" value="@pendiente.Id" />
                    <input type="hidden" name="accion" value="@pendiente.Accion" />
                    <input type="hidden" name="clave" value="@pendiente.Clave" />
                    <input type="hidden" name="usuario" value="@pendiente.Usuario" />
                    <button type="submit" class="btn btn-sm btn-outline-danger">Reintentar la misma operación</button>
                </form>
            }
        </div>
    }

    <section class="hu3-estadisticas" aria-label="Estadísticas de usuarios">
        <div class="hu3-estadistica">
            <span>Total de usuarios</span>
            <strong>@(Model.Resumen?.Total.ToString() ?? "—")</strong>
            @if (Model.Resumen is null) { <small class="metric-status">Sin conexión</small> }
        </div>
        <div class="hu3-estadistica">
            <span>Usuarios activos</span>
            <strong>@(Model.Resumen?.Activos.ToString() ?? "—")</strong>
            @if (Model.Resumen is null) { <small class="metric-status">Sin conexión</small> }
        </div>
        <div class="hu3-estadistica">
            <span>Administradores activos</span>
            <strong>@(Model.Resumen?.AdministradoresActivos.ToString() ?? "—")</strong>
            @if (Model.Resumen is null) { <small class="metric-status">Sin conexión</small> }
        </div>
    </section>

    <section class="hu3-filtros" aria-label="Filtros de usuarios">
        <h2>Buscar y filtrar usuarios</h2>
        <form method="get" role="search">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-lg-6">
                    <label for="hu3Busqueda" class="form-label">Usuario o correo electrónico</label>
                    <input asp-for="Busqueda" id="hu3Busqueda" class="form-control" type="search" autocomplete="off"
                           maxlength="254" placeholder="Buscar por usuario o correo..." />
                </div>
                <div class="col-12 col-md-6 col-lg-3">
                    <label for="hu3RolFiltro" class="form-label">Rol</label>
                    <select asp-for="RolFiltro" class="form-select" id="hu3RolFiltro">
                        <option value="">Todos los roles</option>
                        <option value="Administrador">Administrador</option>
                        <option value="Recepcionista">Recepcionista</option>
                    </select>
                </div>
                <div class="col-12 col-md-6 col-lg-3">
                    <label for="hu3ActivoFiltro" class="form-label">Estado</label>
                    <select asp-for="ActivoFiltro" class="form-select" id="hu3ActivoFiltro">
                        <option value="">Todos</option>
                        <option value="true">Activos</option>
                        <option value="false">Inactivos</option>
                    </select>
                </div>
            </div>
            <div class="hu3-filtros-pie">
                <button type="submit" class="btn btn-secondary btn-sm">Buscar</button>
                <a asp-page="./Index" class="hu3-limpiar">Limpiar filtros</a>
            </div>
        </form>
    </section>

    <div id="usuarios-resultados">
        <partial name="_ResultadosUsuarios" model="Model" />
    </div>

    <dialog id="usuario-estado-dialog" class="usuarios-confirmacion"
            aria-labelledby="usuario-estado-titulo" aria-describedby="usuario-estado-nombre usuario-estado-descripcion">
        <div class="usuarios-confirmacion-cabecera">
            <span class="usuarios-confirmacion-icono" aria-hidden="true">!</span>
            <div>
                <p class="usuarios-confirmacion-kicker">ACCESO AL SISTEMA</p>
                <h2 id="usuario-estado-titulo">Desactivar usuario</h2>
            </div>
        </div>
        <div class="usuarios-confirmacion-contenido">
            <p id="usuario-estado-nombre" class="usuarios-confirmacion-nombre" data-usuario-confirmacion></p>
            <p id="usuario-estado-descripcion">La cuenta no podrá iniciar sesión y sus sesiones abiertas se cerrarán.</p>
        </div>
        <div class="usuarios-confirmacion-acciones">
            <button type="button" class="btn usuarios-confirmacion-cancelar" data-cancelar-usuario autofocus>Cancelar</button>
            <button type="button" class="btn usuarios-confirmacion-aceptar" data-confirmar-usuario>Desactivar usuario</button>
        </div>
    </dialog>
</div>

@section Scripts {
    <script src="~/js/usuarios.js" asp-append-version="true"></script>
}
