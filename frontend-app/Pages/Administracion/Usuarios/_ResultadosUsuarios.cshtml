@model AutoTallerPro.Frontend.Pages.Administracion.Usuarios.IndexModel

<div data-usuarios-resultados>
    <p class="hu3-resultados">Listado no disponible: conexión pendiente con el servicio de usuarios.</p>
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <caption class="visually-hidden">Listado de usuarios</caption>
            <thead>
                <tr>
                    <th scope="col">Usuario</th>
                    <th scope="col">Correo electrónico</th>
                    <th scope="col">Rol</th>
                    <th scope="col">Activo</th>
                    <th scope="col">Fecha de creación</th>
                    <th scope="col" class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Usuarios.Count == 0)
                {
                    <tr data-usuarios-vacio>
                        <td colspan="6">Sin datos disponibles. No se ha consultado el servicio de usuarios.</td>
                    </tr>
                }
                @foreach (var usuario in Model.Usuarios)
                {
                    <tr>
                        <td>@usuario.Username</td>
                        <td>@usuario.Email</td>
                        <td>
                            <span class="badge @(usuario.Rol == "Administrador" ? "bg-danger" : "bg-primary")">@usuario.Rol</span>
                        </td>
                        <td><span class="badge @(usuario.Activo ? "bg-success" : "bg-secondary")">@(usuario.Activo ? "Sí" : "No")</span></td>
                        <td>@usuario.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm" role="group" aria-label="Acciones de usuario">
                                <button type="button" class="btn btn-outline-primary" title="Editar: operación temporalmente inhabilitada" disabled data-operacion-usuario>Editar</button>
                                @if (usuario.Activo)
                                {
                                    <button type="button" class="btn btn-outline-warning" title="Desactivar: operación temporalmente inhabilitada" disabled data-operacion-usuario>Desactivar</button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-outline-success" title="Activar: operación temporalmente inhabilitada" disabled data-operacion-usuario>Activar</button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <nav aria-label="Paginación de usuarios" class="mt-3">
        <ul class="pagination justify-content-center">
            <li class="page-item disabled">
                <span class="page-link" aria-label="Anterior" aria-disabled="true"><span aria-hidden="true">&laquo;</span></span>
            </li>
            <li class="page-item disabled"><span class="page-link" aria-disabled="true">Sin datos</span></li>
            <li class="page-item disabled">
                <span class="page-link" aria-label="Siguiente" aria-disabled="true"><span aria-hidden="true">&raquo;</span></span>
            </li>
        </ul>
    </nav>
</div>
