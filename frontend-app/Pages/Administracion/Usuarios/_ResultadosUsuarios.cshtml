@model AutoTallerPro.Frontend.Pages.Administracion.Usuarios.IndexModel
@using AutoTallerPro.Frontend.ApiUsuarios

@{
    var resultado = Model.Resultado;
}

<div data-usuarios-resultados>
    @if (resultado is null)
    {
        <p class="hu3-resultados">No se pudo cargar el listado de usuarios.</p>
    }
    else
    {
        <p class="hu3-resultados">@resultado.Total @(resultado.Total == 1 ? "usuario encontrado." : "usuarios encontrados.")</p>
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <caption class="visually-hidden">Listado de usuarios</caption>
                <thead>
                    <tr>
                        <th scope="col">Usuario</th>
                        <th scope="col">Nombre</th>
                        <th scope="col">Correo electrónico</th>
                        <th scope="col">Rol</th>
                        <th scope="col">Activo</th>
                        <th scope="col">Invitación</th>
                        <th scope="col" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (resultado.Usuarios.Length == 0)
                    {
                        <tr>
                            <td colspan="7">No hay usuarios para los filtros seleccionados.</td>
                        </tr>
                    }
                    @foreach (var usuario in resultado.Usuarios)
                    {
                        var pendiente = Model.Pendiente?.Id == usuario.Id && Model.Reintento is not null;
                        var espera = Model.EsperaReenvio is { } e && e.Id == usuario.Id ? e.Segundos : 0;
                        <tr>
                            <td>@usuario.Username</td>
                            <td>@usuario.Nombre @usuario.Apellido</td>
                            <td>@usuario.Email</td>
                            <td>
                                <span class="badge @(usuario.Rol == "Administrador" ? "bg-danger" : "bg-primary")">@usuario.Rol</span>
                            </td>
                            <td><span class="badge @(usuario.Activo ? "bg-success" : "bg-secondary")">@(usuario.Activo ? "Sí" : "No")</span></td>
                            <td><span class="badge @EstadosInvitacion.Clase(usuario.EstadoInvitacion)">@EstadosInvitacion.Texto(usuario.EstadoInvitacion)</span></td>
                            <td class="text-end">
                                <div class="d-flex flex-wrap gap-1 justify-content-end">
                                    <a asp-page="./Editar" asp-route-id="@usuario.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                    <form method="post" asp-page-handler="Accion" data-usuarios-escritura
                                          asp-route-Busqueda="@Model.Busqueda" asp-route-RolFiltro="@Model.RolFiltro"
                                          asp-route-ActivoFiltro="@Model.ActivoFiltro" asp-route-Pagina="@Model.Pagina"
                                          data-confirmar-desactivar="@(usuario.Activo ? usuario.Username : null)">
                                        <input type="hidden" name="id" value="@usuario.Id" />
                                        <input type="hidden" name="accion" value="@(usuario.Activo ? "desactivar" : "reactivar")" />
                                        <input type="hidden" name="clave" value="@Guid.NewGuid()" />
                                        <input type="hidden" name="usuario" value="@usuario.Username" />
                                        @if (usuario.Activo)
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-warning" disabled="@pendiente">Desactivar</button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-success" disabled="@pendiente">Reactivar</button>
                                        }
                                    </form>
                                    @if (usuario.PuedeReenviarInvitacion)
                                    {
                                        <form method="post" asp-page-handler="Accion" data-usuarios-escritura
                                              asp-route-Busqueda="@Model.Busqueda" asp-route-RolFiltro="@Model.RolFiltro"
                                              asp-route-ActivoFiltro="@Model.ActivoFiltro" asp-route-Pagina="@Model.Pagina">
                                            <input type="hidden" name="id" value="@usuario.Id" />
                                            <input type="hidden" name="accion" value="reenviar" />
                                            <input type="hidden" name="clave" value="@Guid.NewGuid()" />
                                            <input type="hidden" name="usuario" value="@usuario.Username" />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary"
                                                    data-espera="@(!pendiente && espera > 0 ? espera : null)" disabled="@(pendiente || espera > 0)">
                                                Reenviar invitación
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <nav aria-label="Paginación de usuarios" class="mt-3">
            <ul class="pagination justify-content-center">
                <li class="page-item @(resultado.Pagina <= 1 ? "disabled" : "")">
                    <a class="page-link" aria-label="Anterior" asp-page="./Index"
                       asp-route-Busqueda="@Model.Busqueda" asp-route-RolFiltro="@Model.RolFiltro"
                       asp-route-ActivoFiltro="@Model.ActivoFiltro" asp-route-Pagina="@(resultado.Pagina - 1)"><span aria-hidden="true">&laquo;</span></a>
                </li>
                <li class="page-item disabled"><span class="page-link">Página @resultado.Pagina de @resultado.TotalPaginas</span></li>
                <li class="page-item @(resultado.Pagina >= resultado.TotalPaginas ? "disabled" : "")">
                    <a class="page-link" aria-label="Siguiente" asp-page="./Index"
                       asp-route-Busqueda="@Model.Busqueda" asp-route-RolFiltro="@Model.RolFiltro"
                       asp-route-ActivoFiltro="@Model.ActivoFiltro" asp-route-Pagina="@(resultado.Pagina + 1)"><span aria-hidden="true">&raquo;</span></a>
                </li>
            </ul>
        </nav>
    }
</div>
