@page
@model AutoTallerPro.Frontend.Pages.Clientes.IndexModel
@{ ViewData["Title"] = "Gestión de Clientes"; }
@section Styles {
    <link rel="stylesheet" href="~/css/servicios.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/grupo-uno.css" asp-append-version="true" />
}

<div class="dashboard grupo-uno-page">
    <div class="dashboard-header">
        <div><h1>Gestión de Clientes</h1><p>Administra los clientes registrados en el taller.</p></div>
        <div class="services-actions">

            <a asp-page="./Crear" class="services-btn services-btn-primary" data-crud-modal>＋ Nuevo cliente</a>
        </div>
    </div>
    @if (TempData["GrupoUnoMensaje"] is string mensaje)
    { <div class="grupo-alert grupo-alert-success" role="status">@mensaje</div> }
    <div class="services-actions grupo-toolbar">
        <form method="get" class="services-actions grupo-buscador" role="search">
            <label class="visually-hidden" asp-for="Buscar">Buscar clientes</label>
            <input asp-for="Buscar" class="service-input" type="search" placeholder="Buscar por CI/NIT o nombre…" maxlength="150" />
            <button type="submit" class="services-btn services-btn-secondary">Buscar</button>
            @if (!string.IsNullOrWhiteSpace(Model.Buscar)) { <a asp-page="./Index" class="services-btn services-btn-secondary">Limpiar</a> }
            <input type="hidden" asp-for="Ordenar" />
            <input type="hidden" asp-for="Descendente" />
        </form>
        <a asp-page="./Index" asp-route-buscar="@Model.Buscar" asp-route-ordenar="@Model.Ordenar" asp-route-descendente="@Model.Descendente" class="services-btn services-btn-secondary">Refrescar</a>
    </div>
    <form method="get" class="grupo-ordenacion">
        <input type="hidden" asp-for="Buscar" id="buscar-ordenacion" />
        <label for="ordenar">Ordenar por</label>
        <select asp-for="Ordenar" id="ordenar" class="service-input">
            <option value="nombre">Nombre o razón social</option><option value="documento">CI/NIT</option><option value="telefono">Teléfono</option><option value="correo">Correo electrónico</option><option value="fecha">Fecha de registro</option>
        </select>
        <label class="visually-hidden" for="descendente">Dirección</label>
        <select asp-for="Descendente" id="descendente" class="service-input"><option value="false">Ascendente</option><option value="true">Descendente</option></select>
        <button type="submit" class="services-btn services-btn-secondary">Aplicar</button>
    </form>
    @if (Model.Error is not null) { <div class="grupo-alert grupo-alert-error" role="alert">@Model.Error</div> }

    <section class="recent-orders" aria-labelledby="listado-titulo">
        <div class="section-header"><div><h2 id="listado-titulo">Clientes registrados</h2><p>@Model.Registros.Count registro(s) encontrado(s)</p></div></div>
        @if (Model.Error is not null)
        { <div class="services-empty"><strong>No se pudo cargar el listado</strong><span>Vuelve a intentar con el botón Refrescar.</span></div> }
        else if (Model.Registros.Count == 0)
        {
            <div class="services-empty"><div class="grupo-empty-icon" aria-hidden="true">👤</div><strong>@(string.IsNullOrWhiteSpace(Model.Buscar) ? "Todavía no hay registros" : "No se encontraron coincidencias")</strong><span>Registra un nuevo cliente o prueba con otros términos de búsqueda.</span></div>
        }
        else
        {
            <div class="table-container">
                <table class="orders-table services-table">
                    <caption class="visually-hidden">Listado de clientes</caption>
                    <thead><tr><th scope="col">CI/NIT</th><th scope="col">Nombre o razón social</th><th scope="col">Teléfono</th><th scope="col">Correo electrónico</th><th scope="col">Estado</th><th scope="col">Acciones</th></tr></thead>
                    <tbody>
                    @foreach (var registro in Model.Registros)
                    {
                        <tr>
                    <td class="service-name">@registro.Documento</td>
                    <td>@registro.Nombre</td>
                    <td>@(string.IsNullOrWhiteSpace(registro.Telefono) ? "—" : registro.Telefono)</td>
                    <td>@(string.IsNullOrWhiteSpace(registro.Correo) ? "—" : registro.Correo)</td>
                            <td><span class="grupo-estado @(registro.Activo ? "grupo-estado-activo" : "grupo-estado-inactivo")">@(registro.Activo ? "Activo" : "Inactivo")</span></td>
                            <td><div class="services-row-actions">
                                <a asp-page="./Editar" asp-route-id="@registro.Id" class="service-action service-action-edit" data-crud-modal aria-label="Editar cliente">✎</a>
                                <a asp-page="./Eliminar" asp-route-id="@registro.Id" class="service-action service-action-delete" data-crud-modal aria-label="Eliminar cliente">🗑</a>
                            </div></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
<partial name="_DialogoGrupoUno" />
@section Scripts { <partial name="_ScriptsGrupoUno" /> }
