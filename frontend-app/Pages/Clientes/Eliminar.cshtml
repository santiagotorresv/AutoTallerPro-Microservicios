@page "{id}"
@model AutoTallerPro.Frontend.Pages.Clientes.EliminarModel
@{ ViewData["Title"] = "Eliminar cliente"; }
@section Styles {
    <link rel="stylesheet" href="~/css/servicios.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/grupo-uno.css" asp-append-version="true" />
}

<div class="dashboard grupo-uno-page">
    <div class="dashboard-header"><div><h1>Eliminar cliente</h1><p>Confirma el registro antes de eliminarlo.</p></div><a asp-page="./Index" class="services-btn services-btn-secondary">Volver</a></div>
    <section class="service-form-card" data-crud-content>
        <div class="service-form-header"><div><h2>Eliminar cliente</h2><p>Revisa los datos del registro seleccionado.</p></div></div>
        <form method="post" asp-page="./Eliminar" asp-route-id="@ViewContext.RouteData.Values["id"]" class="service-form" data-crud-form>
            @if (Model.Error is not null) { <div class="grupo-alert grupo-alert-error" role="alert">@Model.Error</div> }
            @if (Model.Registro is not null)
            {
                <div class="service-delete-warning"><strong>¿Confirmas que deseas eliminar este cliente?</strong><span>Esta operación no se puede deshacer.</span></div>
                <div class="service-delete-details"><div class="service-delete-item"><span>Registro seleccionado</span><strong>@(Model.Registro.Nombre)</strong></div><div class="service-delete-item"><span>Estado</span><strong>@(Model.Registro.Activo ? "Activo" : "Inactivo")</strong></div></div>
                <div class="service-form-actions"><a asp-page="./Index" class="services-btn services-btn-secondary" data-crud-cancel>Cancelar</a><button type="submit" class="services-btn services-btn-danger">Confirmar eliminación</button></div>
            }
            else { <a asp-page="./Index" class="services-btn services-btn-secondary" data-crud-cancel>Volver al listado</a> }
        </form>
    </section>
</div>
@section Scripts { <partial name="_ScriptsGrupoUno" /> }
