@page "{id}"
@model AutoTallerPro.Frontend.Pages.Mecanicos.EditarModel
@{ ViewData["Title"] = "Editar mecánico"; }
@section Styles { <link rel="stylesheet" href="~/css/grupo-uno.css" asp-append-version="true" /> }
<div class="grupo-uno"><nav aria-label="Módulos del taller"><a asp-page="/Clientes/Index">Clientes</a><a asp-page="/Vehiculos/Index">Vehículos</a><a asp-page="/Categorias/Index">Categorías</a><a asp-page="/Servicios/Index">Servicios</a><a asp-page="/Mecanicos/Index">Mecánicos</a></nav><h1>Editar mecánico</h1><p>Los campos con * son obligatorios.</p>
@if (Model.Error is not null) { <div class="alert alert-danger" role="alert">@Model.Error</div> }
<form method="post" class="card"><div asp-validation-summary="All" class="text-danger" role="alert"></div><div class="campos"><div class="campo"><label asp-for="Input.Nombres">Nombres *</label><input asp-for="Input.Nombres" type="text" class="form-control" /><span asp-validation-for="Input.Nombres" class="text-danger"></span></div><div class="campo"><label asp-for="Input.Apellidos">Apellidos *</label><input asp-for="Input.Apellidos" type="text" class="form-control" /><span asp-validation-for="Input.Apellidos" class="text-danger"></span></div><div class="campo"><label asp-for="Input.Documento">Documento de identidad *</label><input asp-for="Input.Documento" type="text" class="form-control" /><span asp-validation-for="Input.Documento" class="text-danger"></span></div><div class="campo"><label asp-for="Input.Telefono">Teléfono</label><input asp-for="Input.Telefono" type="tel" class="form-control" /><span asp-validation-for="Input.Telefono" class="text-danger"></span></div><div class="campo"><label asp-for="Input.Correo">Correo electrónico</label><input asp-for="Input.Correo" type="email" class="form-control" /><span asp-validation-for="Input.Correo" class="text-danger"></span></div><div class="campo"><label asp-for="Input.Especialidad">Especialidad *</label><select asp-for="Input.Especialidad" class="form-select"><option value="">Seleccione una especialidad</option><option>Mecánica general</option><option>Electricidad</option><option>Diagnóstico</option><option>Carrocería</option></select><span asp-validation-for="Input.Especialidad" class="text-danger"></span></div><div class="campo"><label asp-for="Input.Activo">Activo</label><input asp-for="Input.Activo" type="checkbox" class="form-check-input" /><span asp-validation-for="Input.Activo" class="text-danger"></span></div></div><div class="acciones"><button type="submit" class="btn btn-primary">Guardar</button><a asp-page="./Index" class="btn btn-secondary">Cancelar</a></div></form></div>
@section Scripts {
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
<script>document.querySelectorAll('form[method="post"]').forEach(f => f.addEventListener('submit', () => { if (typeof $ === 'function' && !$(f).valid()) return; const b = f.querySelector('button[type="submit"]'); if(b) { b.disabled = true; b.textContent = 'Guardando…'; } }));</script>
}
