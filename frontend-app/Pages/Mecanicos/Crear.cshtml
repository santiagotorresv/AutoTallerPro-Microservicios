@page
@model AutoTallerPro.Frontend.Pages.Mecanicos.CrearModel
@{
    ViewData["Title"] = "Nuevo mecánico";
    ViewData["EsEdicion"] = false;
}
@section Styles {
    <link rel="stylesheet" href="~/css/mecanicos.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/grupo-uno.css" asp-append-version="true" />
}

<div class="dashboard grupo-uno-page mecanicos-page">
    <div class="dashboard-header"><div><h1>@ViewData["Title"]</h1><p>Administra el personal técnico registrado en el taller.</p></div><a asp-page="./Index" class="services-btn services-btn-secondary">Volver</a></div>
    <partial name="_Formulario" model="Model" />
</div>
@section Scripts { <partial name="_ScriptsGrupoUno" /> }
