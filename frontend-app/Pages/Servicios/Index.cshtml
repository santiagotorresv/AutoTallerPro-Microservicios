@page
@model AutoTallerPro.Frontend.Pages.Servicios.IndexModel
@{ ViewData["Title"] = "Gestión de Servicios"; }
@section Styles {
    <link rel="stylesheet" href="~/css/servicios.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/grupo-uno.css" asp-append-version="true" />
}

<div class="dashboard grupo-uno-page">
    <div class="dashboard-header">
        <div><h1>Gestión de Servicios</h1><p>Consulta y administra los servicios registrados.</p></div>
        <div class="services-actions">
            <a asp-page="/Categorias/Index" class="services-btn services-btn-secondary">Gestionar categorías</a>
            <a asp-page="./Crear" class="services-btn services-btn-primary">＋ Nuevo servicio</a>
        </div>
    </div>
    @if (TempData["GrupoUnoMensaje"] is string mensaje)
    { <div class="grupo-alert grupo-alert-success" role="status">@mensaje</div> }
    <div class="services-actions grupo-toolbar">
        <form method="get" class="services-actions grupo-buscador" role="search">
            <label class="visually-hidden" asp-for="Buscar">Buscar servicios</label>
            <input asp-for="Buscar" class="service-input" type="search" placeholder="Buscar por nombre…" maxlength="150" />
            <button type="submit" class="services-btn services-btn-secondary">Buscar</button>
            @if (!string.IsNullOrWhiteSpace(Model.Buscar)) { <a asp-page="./Index" class="services-btn services-btn-secondary">Limpiar</a> }
            <input type="hidden" asp-for="Ordenar" />
            <input type="hidden" asp-for="Descendente" />
        </form>
        <a asp-page="./Index" asp-route-buscar="@Model.Buscar" asp-route-ordenar="@Model.Ordenar" asp-route-descendente="@Model.Descendente" class="services-btn services-btn-secondary">Refrescar</a>
    </div>
    <form method="get" class="grupo-ordenacion">
        <input type="hidden" asp-for="Buscar" id="buscar-ordenacion" />
        <label for="ordenar">Ordenar por</label>
        <select asp-for="Ordenar" id="ordenar" class="service-input">
            <option value="nombre">Nombre</option><option value="preciobase">Precio base</option><option value="duracionestimada">Duración estimada</option><option value="fecha">Fecha de registro</option>
        </select>
        <label class="visually-hidden" for="descendente">Dirección</label>
        <select asp-for="Descendente" id="descendente" class="service-input"><option value="false">Ascendente</option><option value="true">Descendente</option></select>
        <button type="submit" class="services-btn services-btn-secondary">Aplicar</button>
    </form>
    @if (Model.Error is not null) { <div class="grupo-alert grupo-alert-error" role="alert">@Model.Error</div> }
    @if (Model.ErrorRelacion is not null) { <div class="grupo-alert grupo-alert-warning" role="status">@Model.ErrorRelacion</div> }
    <section class="recent-orders" aria-labelledby="listado-titulo">
        <div class="section-header"><div><h2 id="listado-titulo">Servicios registrados</h2><p>@Model.Registros.Count registro(s) encontrado(s)</p></div></div>
        @if (Model.Error is not null)
        { <div class="services-empty"><strong>No se pudo cargar el listado</strong><span>Vuelve a intentar con el botón Refrescar.</span></div> }
        else if (Model.Registros.Count == 0)
        {
            <div class="services-empty"><div class="grupo-empty-icon" aria-hidden="true">🔧</div><strong>@(string.IsNullOrWhiteSpace(Model.Buscar) ? "Todavía no hay registros" : "No se encontraron coincidencias")</strong><span>Registra un nuevo servicio o prueba con otros términos de búsqueda.</span></div>
        }
        else
        {
            <div class="table-container">
                <table class="orders-table services-table">
                    <caption class="visually-hidden">Listado de servicios</caption>
                    <thead><tr><th scope="col">Nombre</th><th scope="col">Descripción</th><th scope="col">Categoría</th><th scope="col">Precio base (Bs)</th><th scope="col">Duración (minutos)</th><th scope="col">Estado</th><th scope="col">Acciones</th></tr></thead>
                    <tbody>
                    @foreach (var registro in Model.Registros)
                    {
                        <tr>
                    <td class="service-name">@registro.Nombre</td>
                    <td>@(string.IsNullOrWhiteSpace(registro.Descripcion) ? "—" : registro.Descripcion)</td>
                    <td>@Model.NombreCategoria(registro.CategoriaServicioId)</td>
                    <td>@registro.PrecioBase.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("es-BO"))</td>
                    <td>@(registro.DuracionEstimada?.ToString() ?? "—")</td>
                            <td><span class="grupo-estado @(registro.Activo ? "grupo-estado-activo" : "grupo-estado-inactivo")">@(registro.Activo ? "Activo" : "Inactivo")</span></td>
                            <td><div class="services-row-actions">
                                <a asp-page="./Editar" asp-route-id="@registro.Id" class="service-action service-action-edit" aria-label="Editar servicio">Editar</a>
                                <a asp-page="./Eliminar" asp-route-id="@registro.Id" class="service-action service-action-delete" aria-label="Eliminar servicio">Eliminar</a>
                            </div></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@section Scripts { <partial name="_ScriptsGrupoUno" /> }
