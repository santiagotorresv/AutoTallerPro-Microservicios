@page
@model AutoTallerPro.Frontend.Pages.Servicios.CrearModel
@{ ViewData["Title"] = "Crear servicio"; }
@section Styles { <link rel="stylesheet" href="~/css/grupo-uno.css" asp-append-version="true" /> }
<div class="grupo-uno"><nav aria-label="Módulos del taller"><a asp-page="/Clientes/Index">Clientes</a><a asp-page="/Vehiculos/Index">Vehículos</a><a asp-page="/Categorias/Index">Categorías</a><a asp-page="/Servicios/Index">Servicios</a><a asp-page="/Mecanicos/Index">Mecánicos</a></nav><h1>Crear servicio</h1><p>Los campos con * son obligatorios.</p>
@if (Model.Error is not null) { <div class="alert alert-danger" role="alert">@Model.Error</div> }
<form method="post" class="card"><div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div><div class="campos"><div class="campo"><label asp-for="Input.CategoriaServicioId">Categoría *</label><select asp-for="Input.CategoriaServicioId" class="form-select"><option value="">Seleccione una opción</option>@foreach (var opcion in Model.Opciones.Where(x => x.Activo || x.Id == Model.Input.CategoriaServicioId)) { <option value="@opcion.Id">@opcion.Nombre</option> }</select><span asp-validation-for="Input.CategoriaServicioId" class="text-danger"></span></div><div class="campo"><label asp-for="Input.Nombre">Nombre *</label><input asp-for="Input.Nombre" type="text" class="form-control" /><span asp-validation-for="Input.Nombre" class="text-danger"></span></div><div class="campo"><label asp-for="Input.Descripcion">Descripción</label><input asp-for="Input.Descripcion" type="text" class="form-control" /><span asp-validation-for="Input.Descripcion" class="text-danger"></span></div><div class="campo"><label asp-for="Input.PrecioBase">Precio base (Bs) *</label><input asp-for="Input.PrecioBase" type="number" class="form-control" step="0.01" min="0" /><span asp-validation-for="Input.PrecioBase" class="text-danger"></span></div><div class="campo"><label asp-for="Input.DuracionEstimada">Duración estimada (minutos)</label><input asp-for="Input.DuracionEstimada" type="number" class="form-control" min="1" /><span asp-validation-for="Input.DuracionEstimada" class="text-danger"></span></div><div class="campo"><label asp-for="Input.Activo">Activo</label><input asp-for="Input.Activo" type="checkbox" class="form-check-input" /><span asp-validation-for="Input.Activo" class="text-danger"></span></div></div><div class="acciones"><button type="submit" class="btn btn-primary">Guardar</button><a asp-page="./Index" class="btn btn-secondary">Cancelar</a></div></form></div>
@section Scripts {
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
<script>document.querySelectorAll('form[method="post"]').forEach(f => f.addEventListener('submit', () => { if (typeof $ === 'function' && !$(f).valid()) return; const b = f.querySelector('button[type="submit"]'); if(b) { b.disabled = true; b.textContent = 'Guardando…'; } }));</script>
}
