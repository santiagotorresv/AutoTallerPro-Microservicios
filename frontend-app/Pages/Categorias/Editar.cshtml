@page "{id}"
@model AutoTallerPro.Frontend.Pages.Categorias.EditarModel
@{
    ViewData["Title"] = "Editar categoría";
    ViewData["EsEdicion"] = true;
}
@section Styles {
    <link rel="stylesheet" href="~/css/servicios.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/grupo-uno.css" asp-append-version="true" />
}

<div class="dashboard grupo-uno-page">
    <div class="dashboard-header"><div><h1>@ViewData["Title"]</h1><p>Actualiza la información del registro seleccionado.</p></div><a asp-page="./Index" class="services-btn services-btn-secondary">Volver</a></div>
    <partial name="_Formulario" model="Model" />
</div>
@section Scripts { <partial name="_ScriptsGrupoUno" /> }
