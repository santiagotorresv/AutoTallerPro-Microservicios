{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Authority": "http://127.0.0.1:8180/realms/autotaller",
    "Audience": "autotaller-api"
  },
  "ReverseProxy": {
    "Routes": {
      "clientes-vehiculos-salud": {
        "ClusterId": "ms-clientes",
        "Order": -1,
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/clientes-vehiculos/salud",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/clientes-vehiculos"
          }
        ]
      },
      "clientes-vehiculos": {
        "ClusterId": "ms-clientes",
        "AuthorizationPolicy": "PersonalAutorizado",
        "Match": {
          "Path": "/api/clientes-vehiculos/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/clientes-vehiculos"
          }
        ]
      },
      "servicios-salud": {
        "ClusterId": "ms-servicios",
        "Order": -1,
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/servicios/salud",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/servicios"
          }
        ]
      },
      "servicios": {
        "ClusterId": "ms-servicios",
        "AuthorizationPolicy": "PersonalAutorizado",
        "Match": {
          "Path": "/api/servicios/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/servicios"
          }
        ]
      },
      "mecanicos-salud": {
        "ClusterId": "ms-mecanicos",
        "Order": -1,
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/mecanicos/salud",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/mecanicos"
          }
        ]
      },
      "mecanicos": {
        "ClusterId": "ms-mecanicos",
        "AuthorizationPolicy": "PersonalAutorizado",
        "Match": {
          "Path": "/api/mecanicos/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/mecanicos"
          }
        ]
      },
      "usuarios-salud": {
        "ClusterId": "ms-usuarios",
        "Order": -1,
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/usuarios/salud",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/usuarios"
          }
        ]
      },
      "usuarios": {
        "ClusterId": "ms-usuarios",
        "AuthorizationPolicy": "PersonalAutorizado",
        "Match": {
          "Path": "/api/usuarios/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/usuarios"
          }
        ]
      }
    },
    "Clusters": {
      "ms-clientes": {
        "Destinations": {
          "principal": {
            "Address": "http://127.0.0.1:5101/"
          }
        }
      },
      "ms-servicios": {
        "Destinations": {
          "principal": {
            "Address": "http://127.0.0.1:5102/"
          }
        }
      },
      "ms-mecanicos": {
        "Destinations": {
          "principal": {
            "Address": "http://127.0.0.1:5103/"
          }
        }
      },
      "ms-usuarios": {
        "Destinations": {
          "principal": {
            "Address": "http://127.0.0.1:5104/"
          }
        }
      }
    }
  }
}
