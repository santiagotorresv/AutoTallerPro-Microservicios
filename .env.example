POSTGRES_CLIENTES_DB=clientes_vehiculos
POSTGRES_CLIENTES_USER=clientes_app
POSTGRES_CLIENTES_PASSWORD=
POSTGRES_CLIENTES_PORT=5433
# Modo nube: formato Npgsql (Host=...;Database=...;Username=...;Password=...;SSL Mode=VerifyFull).
# Usa comillas simples alrededor de la cadena completa en tu .env local.
POSTGRES_CLIENTES_CONNECTION_STRING=

MYSQL_SERVICIOS_DB=servicios
MYSQL_SERVICIOS_USER=servicios_app
MYSQL_SERVICIOS_PASSWORD=
MYSQL_SERVICIOS_ROOT_PASSWORD=
MYSQL_SERVICIOS_PORT=3307

MONGO_MECANICOS_DB=mecanicos
MONGO_MECANICOS_USER=mecanicos_app
MONGO_MECANICOS_PASSWORD=
MONGO_MECANICOS_ROOT_USER=mecanicos_admin
MONGO_MECANICOS_ROOT_PASSWORD=
MONGO_MECANICOS_PORT=27018
# Modo nube: URI mongodb+srv de Atlas; la base usada por la API sigue siendo MONGO_MECANICOS_DB.
MONGO_MECANICOS_CONNECTION_STRING=

MYSQL_USUARIOS_DB=usuarios
MYSQL_USUARIOS_USER=usuarios_app
MYSQL_USUARIOS_PASSWORD=
MYSQL_USUARIOS_ROOT_PASSWORD=
MYSQL_USUARIOS_PORT=3308

POSTGRES_KEYCLOAK_DB=keycloak
POSTGRES_KEYCLOAK_USER=keycloak_db
POSTGRES_KEYCLOAK_PASSWORD=
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=admin_local
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=
KEYCLOAK_PORT=8180
KEYCLOAK_USUARIOS_ADMIN_URL=http://keycloak:8080
KEYCLOAK_USUARIOS_REALM=autotaller
KEYCLOAK_USUARIOS_CLIENT_ID=autotaller-usuarios-api
KEYCLOAK_USUARIOS_CLIENT_SECRET=
KEYCLOAK_FRONTEND_CLIENT_SECRET=

KEYCLOAK_SMTP_GMAIL_USER=
KEYCLOAK_SMTP_GMAIL_APP_PASSWORD=
KEYCLOAK_SMTP_GMAIL_FROM=

MAILPIT_WEB_PORT=8025
